  {
   "name": "disconnect_during_delay",
   "notes": "The client closes while the handler is in its delay (SPEC 5.5 step 6): the runner waits for request_body (step 4), not only for request, so the close comes after the body read under every executor. Under --executor worker the body is read on a worker after the request event; a close right after request could come before that read (S7 verifier: no request_body in 2 of 9 runs). Changed in the S7 fix (deviation S7-17).",
   "server": {
    "replies": [
     {
      "delay_ms": 300
     }
    ]
   },
   "steps": [
    {
     "op": "connect"
    },
    {
     "op": "write",
     "data": "GET / HTTP/1.1\r\nHost: x\r\n\r\n"
    },
    {
     "op": "await_event",
     "match": {
      "event": "request_body",
      "conn": 1
     }
    },
    {
     "op": "close"
    }
   ],
   "expect_events": [
    {
     "event": "handler_dropped",
     "conn": 1,
     "req": 1
    },
    {
     "event": "conn_close",
     "conn": 1,
     "outcome": "incomplete"
    }
   ],
   "forbid_events": [
    {
     "event": "handler_done"
    }
   ]
  },
